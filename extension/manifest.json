{
  "manifest_version": 3,
  "name": "Tab Steer",
  "version": "0.2.1",
  "description": "Hand your coding agent a tab, not your browser. Lets a local command-line tool control only the tabs and sites you share.",
  "homepage_url": "https://tabsteer.conceptlix.com",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabGroups",
    "activeTab",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Steer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
