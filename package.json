{
  "name": "tabsteer",
  "version": "0.2.0",
  "description": "Hand your coding agent a tab, not your browser. A CLI that controls only the Chrome tabs and sites you share.",
  "license": "Apache-2.0",
  "author": "Faysal Mehmood",
  "homepage": "https://tabsteer.conceptlix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faysalmehmood/tabsteer.git"
  },
  "bugs": {
    "url": "https://github.com/faysalmehmood/tabsteer/issues"
  },
  "bin": {
    "tabsteer": "bin/tabsteer.js"
  },
  "files": [
    "bin",
    "lib",
    "host",
    "extension",
    "skills"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "test": "node --test test/host.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js",
    "icons": "python3 scripts/make-icons.py",
    "images": "node scripts/store-images.js"
  },
  "keywords": [
    "browser",
    "chrome-extension",
    "cli",
    "ai-agents",
    "coding-agents",
    "browser-automation",
    "native-messaging"
  ],
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
